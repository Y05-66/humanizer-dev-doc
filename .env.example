# Humanizer · 环境变量模板（复制为 .env 后填入真实值）
# ── LLM 改写（clean / refactor 模式需要，可选）───────────────────────────────
LLM_BASE_URL=https://your-api-endpoint.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=agnes-2.5-flash
LLM_TEMPERATURE=1.2

# ── 邮件验证码（可选，启用后支持邮箱二次验证）────────────────────────────
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your@email.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Humanizer <your@email.com>

# ── 短信验证码（可选，需企业资质，国内云服务商要求相同）───────────────────
SMS_PROVIDER=aliyun    # aliyun | tencent
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SIGN_NAME=
ALIYUN_TEMPLATE_CODE=

# ── SQLite 数据文件位置（可选，默认在项目根目录）───────────────────────────
HUMANIZER_DB_PATH=C:/path/to/humanizer.db
